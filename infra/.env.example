# Infra env example. Copy to infra/.env (optional — docker-compose.yml has
# ${VAR:-default} fallbacks so it also runs with no env file). Every variable
# the compose file references is listed here with its built-in default.

# --- Postgres (pgvector) ---
POSTGRES_USER=vaep
POSTGRES_PASSWORD=vaep
POSTGRES_DB=vaep
# Host port. 5433, not 5432, because a local Postgres usually holds 5432.
POSTGRES_PORT=5433

# --- Redis (BullMQ) ---
# Host port. 6380, not 6379, because a local Redis usually holds 6379.
REDIS_PORT=6380

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
# API :9000 and console :9001 are fixed in docker-compose.yml (not env-driven).

# --- Adminer ---
# http://localhost:8080 (fixed port, not env-driven).

# Reference: the API should point at this Postgres/Redis —
#   DATABASE_URL=postgresql://vaep:vaep@localhost:5433/vaep?schema=public
#   REDIS_URL=redis://127.0.0.1:6380
#   S3_ENDPOINT=http://localhost:9000  S3_ACCESS_KEY=minio  S3_SECRET_KEY=minio12345
