{
  "name": "orlixa-workflow-sdk-poc",
  "version": "0.0.0",
  "private": true,
  "description": "POC ONLY — NOT PRODUCTION. Isolated evaluation of Vercel Workflow SDK as a durable execution layer for Orlixa. Not part of the pnpm workspace; nothing here is imported by apps/api.",
  "scripts": {
    "wf:init": "npx --yes @workflow/nest init --force --module commonjs",
    "build": "npm run wf:init && nest build",
    "start": "node dist/main.js",
    "start:dev": "npm run wf:init && nest start --watch",
    "bootstrap:pg": "npx --yes --package=@workflow/world-postgres bootstrap",
    "poc": "node scripts/run-poc.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@workflow/nest": "^4.0.18",
    "@workflow/world-postgres": "^4.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "workflow": "^4.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.15.3",
    "@types/node": "^22.5.5",
    "typescript": "^5.5.4"
  }
}
