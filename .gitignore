# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# turbo
.turbo/

# prisma generated client
apps/api/src/generated/
**/node_modules/.prisma/

# knowledge module local blob storage (LocalStorageProvider)
apps/api/.storage/
.storage/

# automated DB backups (scripts/backup-db.sh) -- generated locally/in CI,
# not meant to accumulate in git history. The one pre-existing manual dump
# already committed before this rule is left alone.
backups/*.dump
backups/*.log

# env
.env
.env.local
.env.*.local

# tests / coverage
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# database backups (infra/backup/backup.sh)
# A dump is a complete copy of every tenant's data, including the encrypted
# columns and the audit trail. It must never reach a git remote.
infra/backup/artifacts/

# Vercel CLI working directory.
# `vercel pull` (used by .github/workflows/deploy.yml and when linking locally)
# writes .vercel/.env.production.local — a plaintext copy of EVERY production
# secret: DATABASE_URL, JWT secrets, ENCRYPTION_KEY, Stripe and LLM keys. It
# must never reach a git remote.
.vercel/

.vercel
.env*
