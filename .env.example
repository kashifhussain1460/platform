# ---------------------------------------------------------------------------
# V-AEP ROOT env example. Copy to .env (root) for shared/local dev values.
# The API reads these (ConfigModule loads ['.env', '../../.env']); the web app
# reads NEXT_PUBLIC_* (apps/web/.env.local). Infra has its own infra/.env.example.
#
# This file carries the everyday local-dev set. The FULL list of every variable
# the API reads — OAuth, Stripe, S3, engines, resilience knobs — lives in
# apps/api/.env.example. Optional lines are commented out and show the default.
# ---------------------------------------------------------------------------

# --- Database (points at the docker-compose postgres on localhost) ---
DATABASE_URL="postgresql://vaep:vaep@localhost:5433/vaep?schema=public"

# --- Auth / JWT (CHANGE THESE for anything but local dev) ---
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TTL="900s"
REFRESH_TTL="7d"

# --- API server ---
PORT="4000"
# The web dev server runs on 3200 (`next dev --port 3200`), so both the CORS
# origin and the email-link base point there. Only one CORS origin is supported.
WEB_ORIGIN="http://localhost:3200"
APP_BASE_URL="http://localhost:3200"
# NODE_ENV="development"
# LOG_FORMAT="json"                 # unset = pretty dev logs

# --- Web (Next.js public runtime) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- Redis (BullMQ queues; docker on 6380 to avoid local redis) ---
REDIS_URL="redis://127.0.0.1:6380"

# --- Deployment shape (see platform/CLAUDE.md) ---
# Set QUEUE_WORKERS_ENABLED="false" ONLY on the Vercel apps/api project
# (HTTP-only serverless entry) so it doesn't run BullMQ consumers — and then you
# MUST also set WORKFLOW_EXECUTION_MODE="inline", otherwise every run is created
# and sits PENDING for ever (gap G40).
# QUEUE_WORKERS_ENABLED="false"
# WORKFLOW_EXECUTION_MODE="queue"   # queue (default) | inline
# WORKFLOW_ENGINE_MODE="state_machine"   # state_machine (default) | legacy_walk
# WORKFLOW_ENGINE_STATE_MACHINE_COMPANIES=""   # comma-separated companyIds (staged rollout)
# Shared secret for /admin/cron/* (Vercel Cron). UNSET DISABLES those routes.
# CRON_SECRET="<random-32+-chars>"
# Where firing alerts are POSTed; unset = alerts reach nobody.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"

# --- AI Employee runtime (all optional; default is fully offline) ---
# LLM backend: mock (default, deterministic/offline) | anthropic | openai
LLM_PROVIDER="mock"
# LLM_MODEL="claude-sonnet-5"       # default: claude-sonnet-5 / gpt-5.6-terra
# LLM_REQUEST_TIMEOUT_MS="60000"    # per-request timeout (default 60s)
# ANTHROPIC_API_KEY="sk-ant-..."    # required when LLM_PROVIDER=anthropic
# OPENAI_API_KEY="sk-..."           # required when LLM_PROVIDER=openai (shared with embeddings)

# --- Knowledge / RAG + storage (zero-infra defaults) ---
EMBEDDINGS_PROVIDER="hash"          # hash (default) | local | openai
STORAGE_PROVIDER="local"            # local (default) | s3
# STORAGE_DIR=".storage"
# S3_* settings live in apps/api/.env.example

# --- Skills execution ---
SKILL_EXECUTOR="mock"               # mock (default) | real | auto
# HTTP_SKILL_ALLOW_PRIVATE="false"  # dev-only SSRF-guard bypass
# OAUTH_REDIRECT_BASE="http://localhost:4000"   # + OAUTH_<PROVIDER>_CLIENT_ID/SECRET

# --- Billing ---
BILLING_PROVIDER="mock"             # mock (default) | stripe
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_* → apps/api/.env.example

# --- Transactional mail (off by default; fixed dev OTP instead) ---
# MAIL_ENABLED="false"
# DEV_OTP_CODE="123456"
# MAIL_FROM="Orlixa <info@orlixa.io>"
# SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASS → apps/api/.env.example

# --- Secrets encryption at rest (skill credentials, HR PII) ---
# 32-byte AES-256 key: 64 hex chars OR base64 of 32 bytes. Optional in dev (an
# insecure key is derived with a warning); MUST be set in production.
# Generate: openssl rand -hex 32
# ENCRYPTION_KEY="<64-hex-chars-or-base64-32-bytes>"
