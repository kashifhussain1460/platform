{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @vaep/api exec prisma generate && npx turbo run build --filter=@vaep/api...",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/admin/cron/workflow-schedules", "schedule": "* * * * *" },
    { "path": "/admin/cron/workflow-watchdog", "schedule": "*/5 * * * *" },
    { "path": "/admin/cron/approval-sla", "schedule": "*/5 * * * *" },
    { "path": "/admin/cron/hr-retention", "schedule": "0 3 * * *" },
    { "path": "/admin/cron/audit-retention", "schedule": "30 3 * * *" },
    { "path": "/admin/cron/data-retention", "schedule": "0 4 * * *" },
    { "path": "/admin/cron/alerts", "schedule": "*/15 * * * *" },
    { "path": "/admin/cron/gmail-poll", "schedule": "* * * * *" },
    { "path": "/admin/cron/connector-reconcile", "schedule": "*/5 * * * *" },
    { "path": "/admin/cron/marketing-sync", "schedule": "*/10 * * * *" },
    { "path": "/admin/cron/marketing-analytics", "schedule": "0 5 * * *" },
    { "path": "/admin/cron/imap-poll", "schedule": "* * * * *" },
    { "path": "/admin/cron/credit-reservation-sweep", "schedule": "*/5 * * * *" },
    { "path": "/admin/cron/subscription-credit-renewal", "schedule": "15 2 * * *" },
    { "path": "/admin/cron/enterprise-credit-agreement-renewal", "schedule": "30 2 * * *" },
    { "path": "/admin/cron/credit-reconciliation", "schedule": "0 6 * * *" },
    { "path": "/admin/cron/credit-finance-rollup", "schedule": "30 6 * * *" }
  ]
}
