{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".perf.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@vaep/types$": "<rootDir>/../../../packages/types/src/index.ts"
  },
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "testTimeout": 60000
}
