# API env example. Copy to apps/api/.env, OR rely on the root .env
# (config.module.ts reads both ['.env', '../../.env']).
DATABASE_URL="postgresql://vaep:vaep@localhost:5433/vaep?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TTL="900s"
REFRESH_TTL="7d"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"

# --- Redis (BullMQ queues; docker on 6380 to avoid local redis) ---
REDIS_URL="redis://127.0.0.1:6380"

# --- Knowledge / RAG (all optional; defaults are zero-infra) ---
# Embeddings: hash (default, offline/deterministic) | local (@xenova) | openai
EMBEDDINGS_PROVIDER="hash"
# Storage: local (default, filesystem) | s3 (MinIO/S3-compatible)
STORAGE_PROVIDER="local"
# STORAGE_DIR=".storage"            # LocalStorageProvider base dir
# OPENAI_API_KEY="sk-..."           # required when EMBEDDINGS_PROVIDER=openai
# S3_ENDPOINT="http://localhost:9000"  # MinIO; required when STORAGE_PROVIDER=s3
# S3_BUCKET="vaep"
# S3_ACCESS_KEY="minio"
# S3_SECRET_KEY="minio12345"

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...        # model defaults to claude-sonnet-5

# --- Secrets encryption at rest (skill credentials, etc.) ---
# 32-byte AES-256 key: 64 hex chars OR base64 of 32 bytes. Optional in dev (an
# insecure key is derived with a warning); MUST be set in production.
# Generate: openssl rand -hex 32
# ENCRYPTION_KEY="<64-hex-chars-or-base64-32-bytes>"

# --- Marketing engine (Postiz, self-hosted) ---
POSTIZ_BASE_URL=http://postiz:3000
POSTIZ_API_KEY=

# --- Support engine (Chatwoot, self-hosted) ---
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_PLATFORM_API_TOKEN=

# --- PM engine (Plane, self-hosted) ---
PLANE_BASE_URL=http://plane:8000

# --- Transactional mail (verification / password reset) ---
# DISABLED by default: while MAIL_ENABLED is not "true", nothing is delivered and
# email verification uses the FIXED dev OTP below so the flow works with no inbox.
# Flip MAIL_ENABLED=true + set SMTP_PASS to send for real (nodemailer is loaded
# lazily, only on the enabled path).
MAIL_ENABLED=false
DEV_OTP_CODE=123456
MAIL_FROM="Orlixa <info@orlixa.io>"

# Outgoing mail (SMTP) — Hostinger, info@orlixa.io.
# Port 587 uses STARTTLS, so SMTP_SECURE=false (secure=true is only for port 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@orlixa.io
SMTP_PASS=                             # your Hostinger mailbox password (do NOT commit)

# Incoming mail (IMAP) — Hostinger, info@orlixa.io. Documented for future
# incoming-mail features; no code reads these yet, so they are inert today.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=true                     # 993 = implicit SSL/TLS
# IMAP_USER=info@orlixa.io
# IMAP_PASS=                           # your Hostinger mailbox password (do NOT commit)
