# ===========================================================================
# V-AEP API (NestJS) — COMPLETE environment reference.
# Copy to apps/api/.env, OR rely on the root .env (config.module.ts reads both
# ['.env', '../../.env']). Every variable the code actually reads is listed
# here; a commented-out line = optional, and the value shown is the default the
# code falls back to. Anything secret is a placeholder — never commit real keys.
# Contract is validated at boot by src/config/env.validation.ts.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Core (REQUIRED — the app will not boot without these)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://vaep:vaep@localhost:5433/vaep?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Redis is a HARD boot dependency for the WHOLE app (the BullMQ root factory
# calls getOrThrow('REDIS_URL') while AppModule is constructed) — even on the
# HTTP-only serverless entry.
REDIS_URL="redis://127.0.0.1:6380"

# ---------------------------------------------------------------------------
# 2. Server / tokens (optional — defaults shown)
# ---------------------------------------------------------------------------
ACCESS_TTL="900s"
REFRESH_TTL="7d"
PORT="4000"
# CORS origin — must be EXACTLY where the browser loads the web app. The web
# dev script is `next dev --port 3200` (apps/web/package.json). Only ONE origin
# is supported: bootstrap.ts passes this string straight to enableCors.
WEB_ORIGIN="http://localhost:3200"
# NODE_ENV="development"                # production | development | test
# Public URL of the WEB app — used to build email verification / password-reset
# links. Same port as WEB_ORIGIN (code default is http://localhost:3200).
APP_BASE_URL="http://localhost:3200"
# LOG_FORMAT="json"                     # unset = pretty dev logs; json = one JSON object per line

# ---------------------------------------------------------------------------
# 3. Execution shape (queue vs serverless) — see platform/CLAUDE.md
# ---------------------------------------------------------------------------
# "false" disables every @Processor (queue consumer) in this process. Set it ONLY
# on the HTTP-only serverless deployment (apps/api/api/index.ts). Producers are
# unaffected. Any other value (including unset) leaves workers ON.
# QUEUE_WORKERS_ENABLED="false"
#
# How a run EXECUTES once created: queue (default, BullMQ worker) | inline
# (executed inside the request). Serverless-only MUST use inline, otherwise every
# run sits PENDING for ever (gap G40).
# WORKFLOW_EXECUTION_MODE="queue"
#
# Workflow engine: state_machine (default, durable) | legacy_walk (opt OUT).
# NOTE: WORKFLOW_EXECUTION_MODE=inline forces legacy_walk regardless — inline has
# no worker to consume advance/attempt jobs (logged loudly at boot).
# WORKFLOW_ENGINE_MODE="state_machine"
# Comma-separated companyIds forced onto the durable engine during a staged
# rollout, even when the global default is legacy_walk.
# WORKFLOW_ENGINE_STATE_MACHINE_COMPANIES=""
# Per-node execution budget in ms (default 30000). On expiry the node's work is
# CANCELLED via AbortSignal, not merely abandoned — a model call left running
# keeps spending on an answer nobody will read. Raise for a genuinely slow
# provider; the chaos suite lowers it so it can prove the bound quickly.
# WORKFLOW_NODE_TIMEOUT_MS="30000"
#
# Shared secret for /admin/cron/* (Vercel Cron sends it as `Authorization: Bearer`,
# or send `X-Cron-Secret`). UNSET DISABLES those routes — it does not leave them open.
# CRON_SECRET="<random-32+-chars>"
#
# Where firing alerts are POSTed (Slack/Teams/generic incoming webhook). If unset,
# alerts fire and NOBODY is notified (logged as an error).
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
# Minutes before the SAME rule at the SAME severity may page again (default 60).
# The sweep runs every 15 min and a breached threshold usually stays breached, so
# without this one incident becomes four pages an hour. An ESCALATION
# (warning -> critical) is a different key and always pages immediately. Set 0 to
# disable suppression.
# ALERT_COOLDOWN_MINUTES="60"

# OpenTelemetry traces. UNSET = tracing is completely off (no SDK, no exporter):
# an exporter pointed at nothing retries forever in the background, and that is
# how observability gets switched off for good. Local collector:
#   docker compose -f infra/docker-compose.yml --profile observability up -d
# then open Jaeger at http://localhost:16686 (Grafana :3001, Prometheus :9090).
# When on, the trace id also becomes the `traceId` in every structured log line,
# so a log search and a trace find each other.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME="orlixa-api"

# Auth rate limit, requests/minute per IP on /auth/* (default 10 — brute-force
# and signup-spam protection). Raise it ONLY for a test harness: the browser E2E
# suite signs up and logs in a dozen times a minute from one address and would
# otherwise 429 itself. Never raise it in production.
# AUTH_THROTTLE_LIMIT="10"

# ---------------------------------------------------------------------------
# 4. Resilience knobs (optional — defaults shown)
# ---------------------------------------------------------------------------
# CONNECTOR_RATE_LIMIT="60"             # egress calls per connector per window
# CONNECTOR_RATE_WINDOW_MS="60000"
# CIRCUIT_FAILURE_THRESHOLD="5"         # failures before the breaker opens
# CIRCUIT_COOLDOWN_MS="30000"           # open → half-open cooldown

# ---------------------------------------------------------------------------
# 5. AI Employee runtime (LLM)
# ---------------------------------------------------------------------------
# mock (default, offline/deterministic — what tests use) | openai | anthropic
LLM_PROVIDER="mock"
# Model id. Defaults: gpt-5.6-terra (openai) / claude-sonnet-5 (anthropic).
# Never hardcode a model in code — a deprecation must be a config change.
# LLM_MODEL="claude-sonnet-5"
# Per-request LLM timeout in ms (default 60000). Bounds a hung completion so it
# cannot stall a run/queue for the SDK's multi-minute default.
# LLM_REQUEST_TIMEOUT_MS="60000"
# ANTHROPIC_API_KEY="sk-ant-..."        # required when LLM_PROVIDER=anthropic
# OPENAI_API_KEY="sk-..."               # required when LLM_PROVIDER=openai (also used by embeddings)

# ---------------------------------------------------------------------------
# 6. Knowledge / RAG (defaults are zero-infra)
# ---------------------------------------------------------------------------
# hash (default, offline/deterministic) | local (@xenova transformers.js) | openai
EMBEDDINGS_PROVIDER="hash"
# local (default, filesystem) | s3 (MinIO / S3-compatible)
STORAGE_PROVIDER="local"
# STORAGE_DIR=".storage"                # base dir for the local provider
# --- only when STORAGE_PROVIDER=s3 ---
# S3_ENDPOINT="http://localhost:9000"   # MinIO from infra/docker-compose.yml
# S3_BUCKET="vaep"
# S3_ACCESS_KEY="minio"
# S3_SECRET_KEY="minio12345"
# S3_REGION="us-east-1"                 # default when unset

# ---------------------------------------------------------------------------
# 7. Skills execution + secrets encryption
# ---------------------------------------------------------------------------
# mock (default, offline sandbox) | real (live calls with decrypted tenant creds)
# | auto (real when connected-with-creds / connectionless, else mock)
SKILL_EXECUTOR="mock"
# "true" lets the real http.request executor reach private/loopback addresses
# (SSRF guard bypass). LOCAL DEV ONLY — leave unset in production.
# HTTP_SKILL_ALLOW_PRIVATE="false"
#
# 32-byte AES-256 key for secrets at rest (skill credentials, HR PII):
# 64 hex chars OR base64 of 32 bytes. Optional in dev (an insecure key is derived
# with a warning); MUST be set in production. Generate: openssl rand -hex 32
# Rotating/changing it makes existing ciphertext undecryptable
# ("Unsupported state or unable to authenticate data").
# ENCRYPTION_KEY="<64-hex-chars-or-base64-32-bytes>"

# ---------------------------------------------------------------------------
# 8. Skills OAuth (authorization-code). Only the providers you enable need creds;
#    when a provider's env is missing, /skills/oauth/authorize answers a clear 400.
# ---------------------------------------------------------------------------
# Public API origin — the redirect URI becomes <base>/skills/oauth/callback.
OAUTH_REDIRECT_BASE="http://localhost:4000"
# google backs the gmail / calendar / gdrive skills
# OAUTH_GOOGLE_CLIENT_ID="<id>.apps.googleusercontent.com"
# OAUTH_GOOGLE_CLIENT_SECRET="GOCSPX-..."
# OAUTH_SLACK_CLIENT_ID="<numeric>.<numeric>"
# OAUTH_SLACK_CLIENT_SECRET="<secret>"
# OAUTH_HUBSPOT_CLIENT_ID="<uuid>"
# OAUTH_HUBSPOT_CLIENT_SECRET="<uuid>"
# atlassian backs the jira skill
# OAUTH_ATLASSIAN_CLIENT_ID="<id>"
# OAUTH_ATLASSIAN_CLIENT_SECRET="<secret>"
# PKCE (S256) is ON for every provider; kill-switch without a deploy:
# OAUTH_PKCE_DISABLED_PROVIDERS="hubspot,slack"

# ---------------------------------------------------------------------------
# 9. Billing
# ---------------------------------------------------------------------------
# mock (default, offline/deterministic) | stripe (lazy SDK)
BILLING_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."       # required when BILLING_PROVIDER=stripe
# STRIPE_WEBHOOK_SECRET="whsec_..."     # required for POST /billing/webhook
# Per-plan Price IDs used to build a Checkout Session on plan change:
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_BUSINESS="price_..."
# STRIPE_PRICE_ENTERPRISE="price_..."

# ---------------------------------------------------------------------------
# 10. Transactional mail (verification / password reset)
# ---------------------------------------------------------------------------
# DISABLED by default: while MAIL_ENABLED is not "true" nothing is delivered and
# email verification uses the FIXED dev OTP below, so the flow works with no inbox.
MAIL_ENABLED=false
DEV_OTP_CODE=123456
MAIL_FROM="Orlixa <info@orlixa.io>"
# Outgoing SMTP (Hostinger). Port 587 = STARTTLS, so SMTP_SECURE=false
# (secure=true is only for port 465). HOST/USER/PASS are getOrThrow — required
# once MAIL_ENABLED=true.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@orlixa.io
SMTP_PASS="<mailbox-password>"          # do NOT commit the real one

# Incoming mail (IMAP) — documented for future incoming-mail features; no code
# reads these yet, so they are inert today.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=true                      # 993 = implicit SSL/TLS
# IMAP_USER=info@orlixa.io
# IMAP_PASS="<mailbox-password>"

# ---------------------------------------------------------------------------
# 11. Foundation engines (self-hosted OSS backends; unset = that engine is off)
# ---------------------------------------------------------------------------
# Marketing (Postiz)
POSTIZ_BASE_URL=http://postiz:3000
POSTIZ_API_KEY=
# Support (Chatwoot)
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_PLATFORM_API_TOKEN=
# Project management (Plane)
PLANE_BASE_URL=http://plane:8000
