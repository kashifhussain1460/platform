# ---------------------------------------------------------------------------
# Web (Next.js) local env. Copy to apps/web/.env.local
#
# The frontend reads exactly ONE variable (src/app/auth-bootstrap.tsx) — there
# is no other process.env / NEXT_PUBLIC_* usage anywhere in apps/web. Everything
# else (LLM keys, OAuth, SMTP, Stripe) is server-side only and belongs in
# apps/api/.env — never expose those through NEXT_PUBLIC_*, it ships to browsers.
# ---------------------------------------------------------------------------

# Base URL of the NestJS API. Must match the API's PORT and be allowed by its
# WEB_ORIGIN (CORS). On Vercel, point this at the deployed apps/api project.
NEXT_PUBLIC_API_URL=http://localhost:4000
